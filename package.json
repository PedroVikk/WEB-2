{
  "name": "nodeapi",
  "version": "1.0.0",
  "description": "API REST desenvolvida com Node.js, Express, TypeScript e TypeORM (MySQL).",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "start:watch": "concurrently \"npm run watch\" \"node --watch dist/index.js\"",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/data-source.js",
    "seed": "node dist/run-seeds.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "typeorm",
    "mysql",
    "api-rest"
  ],
  "author": "PedroVikk",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.24.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
