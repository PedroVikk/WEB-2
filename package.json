{
  "name": "nodeapi",
  "version": "1.0.0",
  "description": "API REST desenvolvida com Node.js, Express, TypeScript e TypeORM (MySQL).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "start:watch": "concurrently \"npx tsc --watch\" \"node --watch ./dist/index.js\"",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/data-source.ts",
    "seed": "ts-node src/seed/index.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "typeorm",
    "mysql",
    "api-rest"
  ],
  "author": "PedroVikk",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "mysql2": "^3.24.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.15.2",
    "concurrently": "^10.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
